# Optional workspace overrides. Never commit .env or put real values in this example.
# Real AI entry points also reuse ~/.config/juanjuan/ai.env for DEEPSEEK_API_KEY.
# Priority for a nonempty key: process environment, workspace .env, shared machine file.
# ai:dev and ai:test never load real private configuration.
# The current handler uses DeepSeek and its model setting in api/ai.js.
DEEPSEEK_API_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
RATE_LIMIT_SALT=
OWNER_STATS_TOKEN=
AI_LOCAL_PORT=4177
