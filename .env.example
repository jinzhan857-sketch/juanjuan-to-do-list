# Copy this file to .env locally. Never commit .env or put real values in this example.
# Only npm run ai:serve reads .env. npm run ai:dev and ai:test never load it.
# The current handler uses DeepSeek and its model setting in api/ai.js.
DEEPSEEK_API_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
RATE_LIMIT_SALT=
OWNER_STATS_TOKEN=
AI_LOCAL_PORT=4177
