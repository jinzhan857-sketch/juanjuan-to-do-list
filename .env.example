# Copy this file to .env locally. Never commit .env or put real values in this example.
# ai:serve and the explicit ai:live-check / ai:live-test commands read .env.
# ai:dev and ai:test never load the real .env.
# The current handler uses DeepSeek and its model setting in api/ai.js.
DEEPSEEK_API_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
RATE_LIMIT_SALT=
OWNER_STATS_TOKEN=
AI_LOCAL_PORT=4177
